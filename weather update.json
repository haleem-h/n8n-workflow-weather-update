    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n\n  // Convert Unix timestamps to human-readable time (Kochi/India time)\n  const formatTime = (unix) => {\n    return new Date(unix * 1000).toLocaleTimeString('en-IN', {\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: true\n    });\n  };\n\n  // Build the final text message string\n  const message = `\n📍 WEATHER REPORT: ${data.name}, ${data.sys.country}\n------------------------------\n🌤 Condition: ${data.weather[0].description.toUpperCase()}\n🌡 Temp: ${data.main.temp}°C\n💧 Humidity: ${data.main.humidity}%\n💨 Wind Speed: ${data.wind.speed} m/s\n👁 Visibility: ${data.visibility / 1000} km\n\n☀️ Sunrise: ${formatTime(data.sys.sunrise)}\n🌙 Sunset: ${formatTime(data.sys.sunset)}\n------------------------------\nGenerated by n8n 🤖\n  `.trim();\n\n  // Replace the node data with our clean message\n  item.json = { \n    text_message: message \n  };\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
